<IfModule mod_ssl.c>
<VirtualHost *:443>
    # The CSS preview: a STATIC copy of the site (a git clone on the branch css-rework) fed with invented JSON fixtures.
    # No PHP, no database, no secrets here. The edit API lives under /_edit (outside the docroot).
    ServerName @DOMAIN@
    DocumentRoot @DOCROOT@

    # Never cached, never indexed (the DNS record is also "DNS only" in Cloudflare, so nothing sits in front of it).
    Header always set Cache-Control "no-store"
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"

    # The docroot is a git repository: serve no metadata, source code, scripts or tooling.
    RedirectMatch 404 "/\.(git|github)(/|$)"
    RedirectMatch 404 "^/(sql|src|deploy|tests|tools|README\.md|[^/]*\.(php|priv|ini|sh|py|in|yml|md))"

    RewriteEngine On
    RewriteRule ^/llms\.txt$ /_edit/ [R=302,L]

    # Same clean URLs as the real site, but the data comes from fixtures/ (queries pick a fixture)
    RewriteRule ^/index\.html$ / [R=301,L]
    RewriteRule ^/(?:reunioes|services)\.html$ /reunioes [R=301,L]
    RewriteRule ^/reunioes/?$ /reunioes.html [L]
    RewriteCond %{QUERY_STRING} (?:^|&)range=(1h|6h|24h|7d|30d)(?:&|$)
    RewriteRule ^/api/chart$ /fixtures/chart-%1.json [L]
    RewriteRule ^/api/chart$ /fixtures/chart-24h.json [L]
    RewriteCond %{QUERY_STRING} (?:^|&)week=([0-9]{4}-[0-9]{2}-[0-9]{2})(?:&|$)
    RewriteCond %{DOCUMENT_ROOT}/fixtures/services-%1.json -f
    RewriteRule ^/api/services$ /fixtures/services-%1.json [L]
    RewriteRule ^/api/services$ /fixtures/services.json [L]

    # Account screens (sign-in, sign-up, password reset, my account): static samples in fixtures/auth/, ?state=erro|enviado|ok|invalido
    # picks a variant. Posting does nothing: the browser is sent back to the page.
    RewriteCond %{REQUEST_METHOD} =POST
    RewriteRule ^/sair/?$ /entrar [R=303,L]
    RewriteCond %{REQUEST_METHOD} =POST
    RewriteRule ^/(entrar|registar|esqueci-palavra-passe|repor-palavra-passe|conta)/?$ /$1 [R=303,L]
    RewriteCond %{QUERY_STRING} (?:^|&)state=([a-z0-9-]+)(?:&|$)
    RewriteCond %{DOCUMENT_ROOT}/fixtures/auth/$1-%1.html -f
    RewriteRule ^/(entrar|registar|esqueci-palavra-passe|repor-palavra-passe|conta)/?$ /fixtures/auth/$1-%1.html [L]
    RewriteRule ^/(entrar|registar|esqueci-palavra-passe|repor-palavra-passe|conta)/?$ /fixtures/auth/$1.html [L]

    # Admin: static samples captured from a throwaway database. Saving does nothing: a POST just comes back to the page.
    RewriteRule ^/admin/api/me$ /fixtures/admin/api-me.json [L]
    RewriteCond %{QUERY_STRING} (?:^|&)part=(week|month|year)(?:&|$)
    RewriteRule ^/admin/api/stats$ /fixtures/admin/api-stats-%1.json [L]
    RewriteRule ^/admin/api/stats$ /fixtures/admin/api-stats-week.json [L]
    RewriteRule ^/admin/api/ - [F]
    RewriteCond %{REQUEST_METHOD} =POST
    RewriteRule ^/admin(/[a-z-]*)?$ /admin$1 [R=303,L]
    RewriteRule ^/admin/?$ /fixtures/admin/reunioes.html [L]
    RewriteCond %{QUERY_STRING} (?:^|&)state=([a-z0-9-]+)(?:&|$)
    RewriteCond %{DOCUMENT_ROOT}/fixtures/admin/$1-%1.html -f
    RewriteRule ^/admin/([a-z-]+)$ /fixtures/admin/$1-%1.html [L]
    RewriteRule ^/admin/([a-z-]+)$ /fixtures/admin/$1.html [L]

    <Directory @DOCROOT@>
        Options -Indexes
        AllowOverride None
        Require all granted
        <IfModule php_module>
            php_admin_flag engine Off
        </IfModule>
        <FilesMatch "\.ph(?:ar|p|tml|ps)$">
            Require all denied
        </FilesMatch>
    </Directory>

    # The edit API (the only code that runs here). Reading is open, writing needs the bearer token.
    Alias /_edit @API_DIR@/public
    <Directory @API_DIR@/public>
        Options -Indexes
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
        FallbackResource /_edit/index.php
        # let PHP see the Authorization header
        SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
    </Directory>

    ErrorLog ${APACHE_LOG_DIR}/rift-css_error.log
    CustomLog ${APACHE_LOG_DIR}/rift-css_access.log combined

SSLCertificateFile /etc/letsencrypt/live/@DOMAIN@/fullchain.pem
SSLCertificateKeyFile /etc/letsencrypt/live/@DOMAIN@/privkey.pem
Include /etc/letsencrypt/options-ssl-apache.conf
</VirtualHost>
</IfModule>
